{
  "schemaVersion": 1,
  "id": "codex-deepseek-provider-config",
  "title": "Codex DeepSeek provider config",
  "description": "Adds a managed DeepSeek provider section to ~/.codex/config.toml without writing API keys.",
  "supportedOS": ["darwin"],
  "failureClasses": ["CODEX_PROVIDER_MISSING"],
  "risk": "reversible_patch",
  "requiresRoot": false,
  "autoAllowed": false,
  "params": [
    {"name": "provider", "default": "deepseek"},
    {"name": "baseURL", "default": "https://api.deepseek.com"},
    {"name": "model", "default": "deepseek-v4-flash", "allowed": ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-chat", "deepseek-reasoner"]},
    {"name": "apiKeyEnv", "default": "DEEPSEEK_API_KEY"},
    {"name": "requireKey", "default": "false", "allowed": ["true", "false"]},
    {"name": "wireAPI", "default": "", "allowed": ["", "responses"]}
  ],
  "preconditions": [
    {"type": "os_is", "value": "darwin"},
    {"type": "file_exists_or_creatable", "path": "~/.codex/config.toml"}
  ],
  "probes": [],
  "patches": [
    {
      "id": "codex-deepseek-provider",
      "type": "append_managed_block_if_missing",
      "path": "~/.codex/config.toml",
      "marker": "CODEX_DEEPSEEK_PROVIDER",
      "content": "[model_providers.${provider}]\nname = \"DeepSeek\"\nbase_url = \"${baseURL}\"\n${wireAPILine}env_key = \"${apiKeyEnv}\"\n\n[profiles.${provider}]\nmodel = \"${model}\"\nmodel_provider = \"${provider}\""
    }
  ],
  "verify": [
    {"id": "managed_block_count", "args": {"path": "~/.codex/config.toml", "marker": "CODEX_DEEPSEEK_PROVIDER", "count": "1"}},
    {"id": "codex_provider_section_present", "args": {"path": "~/.codex/config.toml", "contains": "[model_providers.deepseek]"}},
    {"id": "codex_provider_name_present", "args": {"path": "~/.codex/config.toml", "contains": "name = \"DeepSeek\""}},
    {"id": "codex_provider_base_url_present", "args": {"path": "~/.codex/config.toml", "contains": "${baseURL}"}},
    {"id": "codex_model_present", "args": {"path": "~/.codex/config.toml", "contains": "${model}"}},
    {"id": "codex_provider_env_key_present", "args": {"path": "~/.codex/config.toml", "contains": "env_key = \"${apiKeyEnv}\""}},
    {"id": "codex_provider_key_env_present_redacted", "args": {"env": "${apiKeyEnv}", "required": "${requireKey}"}},
    {"id": "key_not_written_to_config", "args": {"path": "~/.codex/config.toml"}},
    {"id": "codex_provider_smoke_test_required", "args": {}}
  ],
  "rollback": [
    {"type": "restore_file", "path": "~/.codex/config.toml"}
  ],
  "docs": ["docs/offline/RECIPE_AUTHORING.md"]
}
